# Discord Bot Token (Bot sekmesinden alınır)
DISCORD_TOKEN=your_bot_token_here

# Uygulama (Application) ID'si
CLIENT_ID=your_client_id_here

# Komutların kaydedileceği sunucu ID'si (geliştirme için guild bazlı kayıt)
GUILD_ID=your_guild_id_here

# Hoş geldin mesajlarının gönderileceği kanal ID'si
WELCOME_CHANNEL_ID=your_welcome_channel_id_here

# Yeni katılan üyelere otomatik verilecek kayıtsız rol ID'si
UNREGISTERED_ROLE_ID=your_unregistered_role_id_here

# Kayıt tamamlanan üyeye verilecek rol ID'si
REGISTERED_ROLE_ID=your_registered_role_id_here

# Kayıt panelinin gönderileceği kanal ID'si
REGISTRATION_CHANNEL_ID=your_registration_channel_id_here

# Kayıtsız üyelerin ticket mesajı yazabileceği kategori ID'si
UNREGISTERED_CATEGORY_ID=your_unregistered_category_id_here

# Sürekli ihlal bildirimlerinin gönderileceği kanal ID'si (3. ihlalde bildirim)
SUREKLI_IHLAL_CHANNEL_ID=your_persistent_violation_channel_id_here

# Web Yönetim Paneli Ayarları
PORT=3000
JWT_SECRET=quuinx_moderasyon_jwt_secret_key_change_me
ADMIN_EMAIL=admin@quuinx.com
ADMIN_PASSWORD=quuinx123456

# Web sunucusu açıldığında Discord botunu otomatik başlat
BOT_AUTOSTART=true
